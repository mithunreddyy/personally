{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every page is prerendered to its own file (scripts/prerender.mjs), so a path with no file is a
    // real miss: it gets 404.html with a 404 status instead of the home page with a 200
    "not_found_handling": "404-page",
    // The worker sees every request first, so www can be sent to the bare domain
    "run_worker_first": true
  },
  // The visit counter behind /api/visits
  "durable_objects": {
    "bindings": [{ "name": "VISITS", "class_name": "VisitCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitCounter"] }],
  // Custom domains: Cloudflare creates the DNS records and the certificate for these on deploy
  "routes": [
    { "pattern": "mithun.fyi", "custom_domain": true },
    { "pattern": "www.mithun.fyi", "custom_domain": true }
  ]
}
