# Built files carry a content hash in their name, so they never change and can be cached for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must be checked on every visit, or a new deploy would wait a day to reach people
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600
